local function secureEnvironment()
if getrawmetatable and getgc then
local old_index = getrawmetatable(game).__index
if old_index ~= game.__index then
game:GetService("Players").LocalPlayer:Kick("Security Violation: Memory Hook Detected.")
return false
end
end
return true
end
