local function RegisterBallDiagnostics(folder)
local function EvaluateEntity(child)
if child:IsA("BasePart") or child.Name:find("Ball") or child:GetAttribute("Target") or child.Name:lower():find("ball") then
EngineState.ActiveBall = child
end
end
folder.ChildAdded:Connect(EvaluateEntity)
for _, child in ipairs(folder:GetChildren()) do EvaluateEntity(child) end
end
task.spawn(function()
local ballsContainer = workspace:FindFirstChild("Balls")
if ballsContainer then RegisterBallDiagnostics(ballsContainer)
else
workspace.ChildAdded:Connect(function(child)
if child.Name == "Balls" then RegisterBallDiagnostics(child) end
end)
end
end)
local function EvaluateCharacterAsset()
local character = game:GetService("Players").LocalPlayer.Character
if not character then return 0 end
for assetName, latencyOffset in pairs(WeaponWindUpProfiles) do
if character:FindFirstChild(assetName) then return latencyOffset end
end
return 0
end
local function TriggerHardwareParry()
EngineState.LockState = true
task.spawn(function()
local desyncInterval = math.random() * (TitanSettings.JitterMax - TitanSettings.JitterMin) + TitanSettings.JitterMin
task.wait(desyncInterval)
VirtualInputManager:SendKeyEvent(true, TitanSettings.ParryKey, false, game)
task.wait(0.005)
VirtualInputManager:SendKeyEvent(false, TitanSettings.ParryKey, false, game)
task.wait(TitanSettings.RefractoryPeriod)
EngineState.LockState = false
end)
end
game:GetService("RunService").PostSimulation:Connect(function(deltaTime)
if not TitanSettings.AutoParry or EngineState.LockState or not EngineState.ActiveBall or not EngineState.ActiveBall.Parent then return end
local character = game:GetService("Players").LocalPlayer.Character
local rootPart = character and character:FindFirstChild("HumanoidRootPart")
if not rootPart then return end
local ball = EngineState.ActiveBall
local networkTarget = ball:GetAttribute("target") or ball:GetAttribute("Target")
if networkTarget ~= game:GetService("Players").LocalPlayer.Name and networkTarget ~= game:GetService("Players").LocalPlayer.DisplayName then return end
local playerPosition = rootPart.Position
local ballPosition = ball.Position
local ballVelocity = ball.AssemblyLinearVelocity
local currentBallSpeed = ballVelocity.Magnitude
if currentBallSpeed <= 0.1 then return end
local currentClock = os.clock()
local timeDelta = currentClock - EngineState.LastTick
if timeDelta > 0 then
EngineState.Acceleration = (ballVelocity - EngineState.LastVelocity) / timeDelta
end
EngineState.LastVelocity = ballVelocity
EngineState.LastTick = currentClock
local targetVector = (playerPosition - ballPosition).Unit
local velocityVector = ballVelocity.Unit
local threatCoefficient = velocityVector:Dot(targetVector)
local exactDistance = (playerPosition - ballPosition).Magnitude
if threatCoefficient < 0.02 and exactDistance > TitanSettings.AbsoluteThreshold then return end
local dynamicSpeedModifier = 1.00
if currentBallSpeed > 170 then dynamicSpeedModifier = 1.34
elseif currentBallSpeed > 110 then dynamicSpeedModifier = 1.18
elseif currentBallSpeed > 60 then dynamicSpeedModifier = 1.05 end
local networkLatency = game:GetService("Stats").Network.ServerPing:GetValue() / 1000
local activeAssetOffset = EvaluateCharacterAsset()
local predictedSpeed = currentBallSpeed + (EngineState.Acceleration.Magnitude * deltaTime)
local estimatedTimeToImpact = exactDistance / (predictedSpeed > 0 and predictedSpeed or currentBallSpeed)
local computeActivationWindow = networkLatency + activeAssetOffset + deltaTime + ((exactDistance / 920) * TitanSettings.TickRateCompensation * dynamicSpeedModifier)
if exactDistance <= TitanSettings.ClashDistance and currentBallSpeed > 45 then
TriggerHardwareParry()
elseif estimatedTimeToImpact <= computeActivationWindow or exactDistance <= TitanSettings.AbsoluteThreshold then
TriggerHardwareParry()
end
end)
end
